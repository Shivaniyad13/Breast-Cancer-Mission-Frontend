generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid())
  name                 String?
  email                String?               @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  role                 Role                  @default(VOLUNTEER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  accounts             Account[]
  attendance           Attendance[]
  campaigns            Campaign[]
  certificates         Certificate[]
  donations            Donation[]
  profile              Profile?
  doctorProfile        Doctor?
  sessions             Session[]
  webinarRegistrations WebinarRegistration[]
}

model Profile {
  id                    String             @id @default(uuid())
  userId                String             @unique
  phoneNumber           String?
  avatarUrl             String?
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  rejectionReason       String?
  medicalLicenseNumber  String?
  hospitalAffiliation   String?
  specialty             String?
  ngoRegistrationNumber String?
  taxExemptionStatus80G Boolean            @default(false)
  websiteUrl            String?
  nationalIdNumber      String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  documents             Document[]
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Campaign {
  id                  String         @id @default(uuid())
  patientId           String
  title               String
  slug                String         @unique
  description         String
  medicalSummary      String
  fundingGoal         Decimal        @db.Decimal(12, 2)
  amountRaised        Decimal        @default(0) @db.Decimal(12, 2)
  status              CampaignStatus @default(DRAFT)
  ngoEndorserId       String?
  hospitalName        String
  hospitalBankAccount String
  hospitalBankIFSC    String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  patient             User           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documents           Document[]
  donations           Donation[]
  payouts             Payout[]
}

model Document {
  id           String       @id @default(uuid())
  campaignId   String?
  profileId    String?
  documentType DocumentType
  fileUrl      String
  isSecure     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  profile      Profile?     @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Donation {
  id               String         @id @default(uuid())
  campaignId       String?
  donorId          String?
  donorName        String?
  donorEmail       String?
  donorPhone       String?
  message          String?
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @default("INR")
  paymentGatewayId String         @unique
  status           DonationStatus @default(PENDING)
  isAnonymous      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  campaign         Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donor            User?          @relation(fields: [donorId], references: [id])
}

model Payout {
  id                   String       @id @default(uuid())
  campaignId           String
  amountRequested      Decimal      @db.Decimal(12, 2)
  hospitalInvoiceUrl   String
  status               PayoutStatus @default(PENDING)
  transactionReference String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  campaign             Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Certificate {
  id                  String                    @id @default(uuid())
  recipientId         String
  certificateType     CertificateType
  eventName           String
  certificateIdString String                    @unique
  pdfStorageUrl       String
  verificationHash    String                    @unique
  createdAt           DateTime                  @default(now())
  webinarId           String?
  userName            String?
  speakerName         String?
  date                DateTime?
  digitalSignature    String?
  verificationUrl     String?
  recipient           User                      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  webinar             Webinar?                  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  verifications       CertificateVerification[]
}

model Webinar {
  id                    String                @id @default(uuid())
  title                 String
  description           String
  fullContent           String
  bannerImage           String?
  speakerName           String
  speakerImage          String?
  speakerBio            String?
  speakerQualification  String?
  speakerSpecialization String?
  speakerHospital       String?
  date                  DateTime
  startTime             DateTime
  endTime               DateTime
  venue                 String?
  city                  String?
  state                 String?
  country               String?
  webinarMode           String
  meetingLink           String
  maxSeats              Int
  category              String
  status                String                @default("DRAFT")
  webinarType           WebinarType           @default(FREE)
  registrationPrice     Float                 @default(0)
  minimumAllowedPrice   Float                 @default(0)
  durationMinutes       Int                   @default(60)
  approvalStatus        ApprovalStatus        @default(APPROVED)
  approvalRejectionReason String?
  recordingUrl          String?
  materialsUrl          String?
  objectives            String?
  agenda                String?
  faqs                  Json?
  organizerDetails      String?
  language              String?               @default("English")
  meetingPlatform       String?               @default("Zoom")
  learningOutcomes      String?
  eligibility           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  doctorId              String?
  doctor                Doctor?               @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  attendance            Attendance[]
  certificates          Certificate[]
  registrations         WebinarRegistration[]
}

model Doctor {
  id                   String             @id @default(uuid())
  doctorId             String             @unique
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalLicenseNumber String?
  hospitalAffiliation  String?
  specialty            String?
  bio                  String?
  avatarUrl            String?
  verificationStatus   VerificationStatus @default(PENDING)
  rejectionReason      String?
  verificationDocument String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  articles             Article[]
  webinars             Webinar[]
}

model Article {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  excerpt         String?
  summary         String?
  content         String
  category        String
  status          String    @default("PENDING")
  readTime        String    @default("5 min read")
  featuredImage   String?
  fileUrl         String?
  specialty       String?
  rejectionReason String?
  approvedBy      String?
  approvedAt      DateTime?
  views           Int       @default(0)
  authorId        String?
  doctorId        String?
  doctor          Doctor?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model WebinarRegistration {
  id               String   @id @default(uuid())
  userId           String
  webinarId        String
  registeredAt     DateTime @default(now())
  feedback         String?
  rating           Int?
  age              Int      @default(0)
  city             String   @default("")
  email            String   @default("")
  emergencyContact String   @default("")
  gender           String   @default("")
  name             String   @default("")
  occupation       String   @default("")
  phone            String   @default("")
  reason           String   @default("")
  state            String   @default("")
  status           String   @default("Registered")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  webinar          Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([userId, webinarId])
}

model Attendance {
  id                   String    @id @default(uuid())
  userId               String
  webinarId            String
  joinTime             DateTime?
  leaveTime            DateTime?
  durationMinutes      Float     @default(0)
  attendancePercentage Float     @default(0)
  status               String    @default("ABSENT")
  certificateEligible  Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  webinar              Webinar   @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([userId, webinarId])
}

model CertificateVerification {
  id              String      @id @default(uuid())
  certificateId   String
  verificationUrl String
  verifiedAt      DateTime    @default(now())
  ipAddress       String?
  userAgent       String?
  status          String
  certificate     Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
}

enum Role {
  ADMIN
  NGO_REP
  DOCTOR
  PATIENT
  VOLUNTEER
  DONOR
  ORGANIZATION_MEMBER
  CORPORATE_PARTNER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  PENDING_NGO
  PENDING_ADMIN
  ACTIVE
  COMPLETED
  SUSPENDED
}

enum DocumentType {
  MEDICAL_BILL
  DIAGNOSIS_REPORT
  IDENTITY_PROOF
  NGO_LICENSE
  DOCTOR_CREDENTIAL
}

enum DonationStatus {
  PENDING
  SUCCESSFUL
  COMPLETED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
}

enum CertificateType {
  WEBINAR_ATTENDANCE
  QUIZ_EXCELLENCE
  VOLUNTEER_CAMPAIGN
}

enum WebinarType {
  FREE
  PAID
}

enum ApprovalStatus {
  APPROVED
  PENDING_APPROVAL
  REJECTED
}

model OrganizationMember {
  id                     String             @id @default(uuid())
  organizationName       String
  organizationType       String
  ngoRegistrationNumber  String
  yearEstablished        Int
  contactPersonName      String
  designation            String
  email                  String
  mobileNumber           String
  website                String?
  completeAddress        String
  state                  String
  district               String
  city                   String
  pincode                String
  numberOfVolunteers     Int
  areasOfWork            String
  previousExperience     String
  expectedCollaboration  String
  ngoCertificateUrl      String
  organizationLogoUrl    String
  supportingDocumentsUrl String
  isDeclared             Boolean            @default(false)
  status                 VerificationStatus @default(PENDING)
  remarks                String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model CorporatePartner {
  id                     String             @id @default(uuid())
  companyName            String
  industry               String
  gstNumber              String
  cinNumber              String?
  contactPersonName      String
  designation            String
  email                  String
  mobileNumber           String
  website                String?
  companyAddress         String
  state                  String
  city                   String
  pincode                String
  employeeStrength       Int
  csrBudgetCategory      String
  collaborationInterest  String
  companyLogoUrl         String
  csrPolicyUrl           String?
  supportingDocumentsUrl String
  isDeclared             Boolean            @default(false)
  status                 VerificationStatus @default(PENDING)
  remarks                String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model SuccessStory {
  id                String             @id @default(uuid())
  fullName          String
  email             String
  mobileNumber      String
  city              String
  state             String
  age               Int?
  roleType          String             // "Patient" or "Family Member"
  storyTitle        String
  completeStory     String
  videoUrl          String?
  imageUrls         String[]
  treatmentHospital String?
  consent           Boolean            @default(false)
  status            VerificationStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  videoStories      VideoStory[]
}

model HomePageUpdate {
  id               String    @id @default(uuid())
  category         String    // "Webinar", "Campaign", "News", "Event", "Announcement", "Tip", "Research"
  imageUrl         String?
  title            String
  shortDescription String
  detailedContent  String?
  eventDate        DateTime?
  destinationLink  String?
  orderIndex       Int       @default(0)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SponsorBanner {
  id              String    @id @default(uuid())
  logoUrl         String?
  imageUrl        String?
  title           String
  description     String
  destinationLink String?
  orderIndex      Int       @default(0)
  isActive        Boolean   @default(true)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CelebrityTestimonial {
  id           String   @id @default(uuid())
  videoUrl     String
  thumbnailUrl String?
  name         String
  profession   String
  duration     String?
  quote        String
  description  String?
  orderIndex   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LiveUpdate {
  id               String    @id @default(uuid())
  category         String    // "Webinar", "Campaign", "News", "Event", "Research"
  imageUrl         String?
  title            String
  shortDescription String
  fullDescription  String?
  eventDate        DateTime?
  eventTime        String?
  venue            String?
  speakerName      String?
  registrationLink String?
  externalLink     String?
  isFeatured       Boolean   @default(false)
  isActive         Boolean   @default(true)
  publishDate      DateTime?
  expiryDate       DateTime?
  orderIndex       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model DiagnosisTechnology {
  id                         String   @id @default(uuid())
  name                       String
  category                   String
  shortOverview              String
  accuracy                   String?
  purpose                    String
  advantages                 String   // Stores newline-separated or comma-separated benefits
  limitations                String   // Stores newline-separated or comma-separated limitations
  recommendedGroup           String
  imageUrl                   String?
  introVideoUrl              String?
  animationVideoUrl          String?
  explainerVideoUrl          String?
  workflow                   String?
  stepByStep                 String?
  preparation                String?
  duration                   String?
  benefits                   String?
  risks                      String?
  whoShouldTake              String?
  faqs                       Json?    // [{ q: string, a: string }]
  relatedArticles            Json?    // [{ title: string, link: string }]
  brochureUrl                String?
  manufacturerName           String
  manufacturerLogoUrl        String?
  manufacturerOverview       String?
  manufacturerWebsite        String?
  manufacturerCountry        String?
  manufacturerSpecialization String?
  collaborationStatus        String?  // e.g. "Active", "In Discussion", "None"
  isActive                   Boolean  @default(true)
  orderIndex                 Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model CollaborationRequest {
  id                String   @id @default(uuid())
  organizationName  String
  companyName       String
  contactPerson     String
  designation       String
  email             String
  phone             String
  country           String
  website           String?
  technologyName    String
  collaborationType String
  description       String
  brochureUrl       String?
  companyProfileUrl String?
  consent           Boolean  @default(false)
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PartnershipRequest {
  id                String   @id @default(uuid())
  organizationName  String
  organizationType  String
  contactPersonName String
  designation       String?
  email             String
  phone             String
  website           String?
  city              String?
  state             String?
  country           String?
  logoUrl           String?
  documentUrl       String?
  category          String
  description       String?
  reason            String?
  termsAccepted     Boolean  @default(false)
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED
  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PageView {
  id        String   @id @default(uuid())
  path      String
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model VideoPlay {
  id              String   @id @default(uuid())
  videoIdentifier String
  title           String
  category        String   // "SURVIVOR", "DIAGNOSIS", "CELEBRITY", "AWARENESS"
  createdAt       DateTime @default(now())

  @@index([videoIdentifier])
  @@index([category])
}

enum ContentStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model HealthcarePortalHero {
  id          String        @id @default(uuid())
  badge       String        @default("EVIDENCE-BASED CLINICAL PORTAL")
  title       String
  description String
  imageUrl    String?
  videoUrl    String?
  ctaText     String        @default("Join Healthcare Network")
  ctaLink     String        @default("#join-network")
  status      ContentStatus @default(APPROVED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model HealthcarePortalStat {
  id          String        @id @default(uuid())
  label       String
  value       String
  description String?
  icon        String
  sortOrder   Int           @default(0)
  status      ContentStatus @default(APPROVED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ClinicalGuideline {
  id            String        @id @default(uuid())
  title         String
  summary       String
  protocols     Json          // Array of protocol strings
  evidenceLevel String
  references    String
  sourceUrl     String?
  documentUrl   String?
  version       String        @default("v1.0")
  publishedDate DateTime?
  reviewDate    DateTime?
  reviewedBy    String?
  status        ContentStatus @default(APPROVED)
  isPublished   Boolean       @default(true)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isPublished, status, sortOrder])
}

model HealthcareResearchArticle {
  id            String        @id @default(uuid())
  title         String
  category      String
  publishDate   String
  journal       String
  summary       String
  conclusions   String
  authors       String
  institution   String?
  email         String?
  imageUrl      String?
  documentUrl   String?
  externalUrl   String?
  status        ContentStatus @default(APPROVED)
  isPublished   Boolean       @default(true)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isPublished, status, category])
}

model CmeCourse {
  id               String          @id @default(uuid())
  title            String
  format           String
  credits          String
  duration         String
  instructor       String
  syllabus         Json            // Array of strings
  documentUrl      String?
  enrollmentStatus String          @default("Open")
  status           ContentStatus   @default(APPROVED)
  isPublished      Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  enrollments      CmeEnrollment[]

  @@index([isPublished, status])
}

model CmeEnrollment {
  id            String    @id @default(uuid())
  courseId      String
  name          String
  email         String
  licenseNumber String
  status        String    @default("ENROLLED")
  createdAt     DateTime  @default(now())
  course        CmeCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model SpecialistRole {
  id               String        @id @default(uuid())
  name             String
  responsibilities Json          // Array of responsibility strings
  patientRole      String
  collaboration    String
  icon             String
  sortOrder        Int           @default(0)
  status           ContentStatus @default(APPROVED)
  isPublished      Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([isPublished, status, sortOrder])
}

model DecisionAlgorithm {
  id          String                  @id @default(uuid())
  title       String
  description String
  sortOrder   Int                     @default(0)
  status      ContentStatus           @default(APPROVED)
  isPublished Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  steps       DecisionAlgorithmStep[]
}

model DecisionAlgorithmStep {
  id                String            @id @default(uuid())
  algorithmId       String
  stepNumber        String
  title             String
  desc              String
  clinicalChecklist Json              // Array of strings
  guidelinesLink    String?
  source            String?
  documentUrl       String?
  sortOrder         Int               @default(0)
  status            ContentStatus     @default(APPROVED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  algorithm         DecisionAlgorithm @relation(fields: [algorithmId], references: [id], onDelete: Cascade)

  @@index([algorithmId, sortOrder])
}

model ProfessionalResource {
  id          String        @id @default(uuid())
  title       String
  size        String
  format      String
  desc        String
  fileUrl     String
  category    String?
  author      String?
  email       String?
  sortOrder   Int           @default(0)
  status      ContentStatus @default(APPROVED)
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isPublished, status, sortOrder])
}

model MedicalEvent {
  id            String                     @id @default(uuid())
  title         String
  date          String
  speaker       String
  format        String
  location      String
  credits       String
  meetingUrl    String?
  maxSeats      Int                        @default(100)
  bannerUrl     String?
  status        ContentStatus              @default(APPROVED)
  isPublished   Boolean                    @default(true)
  sortOrder     Int                        @default(0)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  registrations MedicalEventRegistration[]

  @@index([isPublished, status])
}

model MedicalEventRegistration {
  id            String       @id @default(uuid())
  eventId       String
  name          String
  email         String
  licenseNumber String
  status        String       @default("REGISTERED")
  createdAt     DateTime     @default(now())
  event         MedicalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model ResearchPartnerRequest {
  id               String        @id @default(uuid())
  applicantName    String
  email            String
  phone            String
  institution      String
  organizationType String
  researchArea     String
  proposal         String
  website          String?
  documentUrl      String?
  status           ContentStatus @default(PENDING)
  reviewedAt       DateTime?
  reviewedBy       String?
  rejectionReason  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
}

model ResearchPartner {
  id           String   @id @default(uuid())
  requestId    String?  @unique
  name         String
  institution  String
  logoUrl      String?
  website      String?
  researchArea String
  description  String?
  sortOrder    Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model ExpertCommunityItem {
  id           String        @id @default(uuid())
  title        String
  description  String
  icon         String
  buttonText   String
  buttonAction String
  sortOrder    Int           @default(0)
  status       ContentStatus @default(APPROVED)
  isPublished  Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([isPublished, status, sortOrder])
}

model VolunteerDoctorRequest {
  id              String        @id @default(uuid())
  name            String
  email           String
  phone           String
  specialty       String
  licenseNumber   String?
  hospital        String?
  message         String?
  status          ContentStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
}

model HealthcareFaq {
  id          String        @id @default(uuid())
  question    String
  answer      String
  category    String        @default("General")
  sortOrder   Int           @default(0)
  status      ContentStatus @default(APPROVED)
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isPublished, status, sortOrder])
}

model HealthcarePortalCta {
  id                  String        @id @default(uuid())
  heading             String
  description         String
  primaryButtonText   String
  primaryButtonUrl    String
  secondaryButtonText String?
  secondaryButtonUrl  String?
  status              ContentStatus @default(APPROVED)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model CareProvider {
  id             String   @id @default(uuid())
  name           String
  category       String
  specialization String
  city           String
  state          String?
  phone          String
  email          String
  address        String
  website        String?
  hours          String?
  about          String
  facilities     String[]
  rating         Float    @default(0)
  reviews        Int      @default(0)
  isVerified     Boolean  @default(false)
  isPublished    Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, category])
  @@index([isPublished, city])
}

model GalleryItem {
  id         String    @id @default(uuid())
  imageUrl   String
  caption    String
  category   String    // "Walks", "Camps", "Medical", "Outreach", "Research", "Workshops"
  eventDate  DateTime?
  orderIndex Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive, orderIndex])
}

model VideoStory {
  id             String        @id @default(uuid())
  title          String
  category       String        // "Community Programs", "Partner Interviews", "CSR Activities", "Survivor Stories"
  videoUrl       String
  thumbnailUrl   String?
  description    String?
  sourceType     String        @default("ADMIN")   // "ADMIN" | "SUCCESS_STORY"
  successStoryId String?
  orderIndex     Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  successStory   SuccessStory? @relation(fields: [successStoryId], references: [id], onDelete: SetNull)

  @@index([isActive, orderIndex])
  @@index([successStoryId])
}





