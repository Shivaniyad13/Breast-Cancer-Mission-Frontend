{
  "name": "grs-awareness-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "install:all": "npm install",
    "prisma:generate": "npm run prisma:generate -w backend && npm run prisma:generate -w frontend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "start:frontend": "npm run start -w frontend",
    "start:backend": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
